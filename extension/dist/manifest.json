{
  "manifest_version": 3,
  "name": "LinkLens",
  "version": "1.0.0",
  "description": "Instant ML-powered phishing detection for every URL you visit.",

  "action": {
    "default_popup": "index.html",
    "default_title": "LinkLens"
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "tabs",
    "storage",
    "notifications"
  ],

  "host_permissions": [
    "http://localhost:8000/*"
  ]
}
